#pragma once

// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored on purpose - never commit real WiFi/Blynk credentials.

#define WIFI_SSID            "your-wifi-name"
#define WIFI_PASS            "your-wifi-password"

// From your Blynk.Console template (Blynk.Cloud): Template ID / Name are on
// the template's Info tab; Auth Token is per-device, under Devices > your device.
#define BLYNK_TEMPLATE_ID    "TMPLxxxxxxx"
#define BLYNK_TEMPLATE_NAME  "Plant Watering System"
#define BLYNK_AUTH_TOKEN     "your-device-auth-token"
